# Copy to .env.local for local dev; set the same values in Vercel:
# Project Settings -> Environment Variables -> Production.
#
# These are VALUES, not the websites you get them from. Pasting a URL here is
# the most common way this breaks.

# Super Carl API key. Get it at supercarl.ai -> /integrations/connections.
# Looks like a long opaque token, NOT "supercarl.ai".
SUPERCARL_API_KEY=

# Search history storage. Provision in Vercel -> Storage -> Create Database ->
# Upstash (Serverless DB / Redis) and connect it to the project; the
# integration injects these automatically, so there is normally nothing to
# paste here. Either naming works — the current UPSTASH_REDIS_REST_* pair or
# the legacy KV_REST_API_* pair. With no store connected the app still runs
# every search, it just cannot record one.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic API key. Create at console.anthropic.com -> API Keys -> Create Key.
# MUST start with "sk-ant-api03-" and is roughly 100+ characters.
# NOT "console.anthropic.com". NOT your Claude Pro/Max login.
# The API bills separately from a Claude subscription — add credits under
# Billing or a valid key still fails.
ANTHROPIC_API_KEY=
