# Copy to .env.local for local dev; set the same three in Vercel:
# Project Settings -> Environment Variables.

# Gate on the /api/intake endpoint. Without it the endpoint refuses to run —
# anyone with the URL would otherwise spend your Super Carl credits.
# Generate one with: openssl rand -hex 32
APP_ACCESS_TOKEN=

# Super Carl API key. Mint at https://supercarl.ai -> /integrations/connections
# Programmatic access is available on any plan and consumes your credits.
SUPERCARL_API_KEY=

# Anthropic API key for the dissection and scoring reasoning.
ANTHROPIC_API_KEY=
